# Copy this file to .env and fill in real values.
# Generate secrets with:  openssl rand -base64 48

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=change-me-strong-db-password

# JWT signing secret. Must be at least 256 bits (32 bytes).
JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRATION_SECONDS=900

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to true once to create the initial admin user.
# SEED_ENABLED requires a strong SEED_ADMIN_PASSWORD (>= 12 chars).
SEED_ENABLED=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=